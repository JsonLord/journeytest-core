# JourneyTest cognition profile
COGNITION_PROFILE=local-spark-cloud
LAYA_MODE=auto
LAYA_MODEL_REPO=ichenney/laya-browser-v32b
LAYA_REMOTE_URL=http://127.0.0.1:8791/v1/systemone

LAYA_HOSTED_ENABLED=false
LAYA_HOSTED_FALLBACK_ENABLED=false
LAYA_HOSTED_BASE_URL=
LAYA_HOSTED_API_KEY=
LAYA_HOSTED_AUTH_REQUIRED=false
LAYA_HOSTED_TIMEOUT_MS=30000
LAYA_HOSTED_VERIFY_BELOW=0
LAYA_HOSTED_VERIFY_NO_PROGRESS=false

LAYA_VISION_ENABLED=false
LAYA_VISION_EXPLICIT=false
LAYA_VISION_BASE_URL=
LAYA_VISION_API_KEY=
LAYA_VISION_AUTH_REQUIRED=false
LAYA_VISION_TIMEOUT_MS=30000

SPARK_REASONING_ENABLED=true
SPARK_OPENAI_BASE_URL=
SPARK_OPENAI_API_KEY=
SPARK_AUTH_REQUIRED=false
SPARK_MODEL=spark-x2.5-1.7b
SPARK_TIMEOUT_MS=30000
SPARK_MAX_ATTEMPTS=2

CLOUD_REASONING_ENABLED=true
REASONING_PROVIDER=openai
REASONING_MODEL=gpt-4.1-mini
REASONING_THINKING_LEVEL=low
# When set, OPENAI_BASE_URL selects Pi OpenAI-compatible mode and OPENAI_MODEL is canonical.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_AUTH_REQUIRED=false
OPENAI_CONTEXT_WINDOW=32768
OPENAI_MAX_TOKENS=4096
OPENAI_SUPPORTS_DEVELOPER_ROLE=false
OPENAI_SUPPORTS_REASONING_EFFORT=false
CLOUD_MAX_ATTEMPTS=3
CLOUD_TIMEOUT_MS=60000
CLOUD_RETRY_BASE_MS=250
CLOUD_TERMINAL_VERIFICATION=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
REASONING_CHECKPOINT_EVERY_N_STEPS=0
REASONING_NO_PROGRESS_STEPS=3
